NODE_ENV=development
HOST=0.0.0.0
PORT=9876
# DATABASE_URL=postgresql://aeko:aeko@localhost:5432/aeko
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:19006
HTTP_BODY_LIMIT=10mb
TRUST_PROXY=1
LOG_LEVEL=debug

# Legacy v0 authentication compatibility only
JWT_SECRET=change-me-with-at-least-32-characters
TWO_FACTOR_SECRET_KEY=change-me-with-at-least-32-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:9876/api/v0/auth/google/callback
OAUTH_FAILURE_REDIRECT=aeko://auth/failed
ZEPTOMAIL_API_URL=
ZEPTOMAIL_API_KEY=
EMAIL_SENDER_NAME=Aeko

# Canonical Better Auth v1
BETTER_AUTH_SECRET=change-me-better-auth-secret-with-at-least-32-characters
BETTER_AUTH_URL=http://127.0.0.1:9876
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:19006,aeko://
BETTER_AUTH_GOOGLE_CLIENT_ID=
BETTER_AUTH_GOOGLE_CLIENT_SECRET=
BETTER_AUTH_PASSKEY_RP_ID=localhost
BETTER_AUTH_PASSKEY_RP_NAME=Aeko
BETTER_AUTH_PASSKEY_ORIGIN=http://localhost:9876
BETTER_AUTH_EXPO_SCHEME=aeko
RESEND_API_KEY=
RESEND_FROM=

APPLE_CLIENT_ID
APPLE_CLIENT_SECRET
GOOGLE_CLIENT_ID 
GOOGLE_CLIENT_SECRET
MICROSOFT_CLIENT_ID 
MICROSOFT_CLIENT_SECRET
TWITTER_CLIENT_ID 
TWITTER_CLIENT_SECRET
# Realtime notification delivery. Optional: without it the SSE stream falls
# back to in-process delivery (single instance only) and the relay runs on a
# plain interval instead of BullMQ. The REST inbox is unaffected either way.
REDIS_URL=
