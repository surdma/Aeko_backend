# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=9876
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
HTTP_BODY_LIMIT=10mb
TRUST_PROXY=1
LOG_LEVEL=log

# PostgreSQL / Prisma
DATABASE_URL=postgresql://aeko:aeko@localhost:5432/aeko
DIRECT_URL=postgresql://aeko:aeko@localhost:5432/aeko

# Authentication and security
JWT_SECRET=replace-with-at-least-32-random-characters
TWO_FACTOR_SECRET_KEY=replace-with-exactly-32-random-characters
ADMINJS_COOKIE_SECRET=replace-with-at-least-32-random-characters

# Google OAuth (leave client credentials empty to expose the legacy 503 fallback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:9876/api/auth/google/callback
OAUTH_SUCCESS_REDIRECT=http://localhost:3000/auth/success
OAUTH_FAILURE_REDIRECT=http://localhost:3000/auth/failed

# Email
ZEPTOMAIL_API_URL=
ZEPTOMAIL_API_KEY=
EMAIL_SENDER_NAME=Aeko
EMAIL_USER=replace-me@example.com
EMAIL_PASS=replace-me
RESEND_API_KEY=replace-me

# Media and storage
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
PINATA_API_KEY=replace-me
PINATA_SECRET=replace-me
PINATA_JWT=replace-me

# Payments
FLW_PUBLIC_KEY=replace-me
FLW_SECRET_KEY=replace-me
PAYSTACK_PUBLIC_KEY=replace-me
PAYSTACK_SECRET_KEY=replace-me
STRIPE_PUBLISHABLE_KEY=replace-me
STRIPE_SECRET_KEY=replace-me
STRIPE_WEBHOOK_SECRET=replace-me

# AI
OPENAI_API_KEY=replace-me

# AEKO chain
AEKO_RPC_URL=https://rpc.aeko.online
AEKO_EXPLORER_URL=https://gossip.aeko.online/explorer
AEKO_SERVICE_KEYPAIR=[]
AEKO_TREASURY_ADDRESS=replace-me
AEKO_PLATFORM_FEE_BPS=200
SOCIAL_POSTS_STATE_ACCOUNT=replace-me
SOCIAL_REWARDS_STATE_ACCOUNT=replace-me
REWARD_VAULT_ACCOUNT=replace-me
SOCIAL_STAKING_STATE_ACCOUNT=replace-me
STAKING_COOLDOWN_EPOCHS=7
AEKO_WALLET_ADMIN_FEE_PERCENTAGE=5

# Legacy compatibility values retained until their modules migrate
MONGO_URI=mongodb://localhost:27017/aeko_db
CONTRACT_ADDRESS=replace-me
PRIVATE_KEY=replace-me
POLYGON_ZKEVM_RPC=replace-me
SOLANA_NETWORK=devnet
SOLANA_PRIVATE_KEY=replace-me
SOLANA_RPC_URL=https://api.devnet.solana.com
DEFAULT_CURRENCY=USD
PAYMENT_METHODS=paystack,stripe,aeko_wallet
