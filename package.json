{
  "name": "aeko_backend",
  "version": "1.0.0",
  "description": "Aeko Social backend API",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "dev": "nest start --watch -b swc",
    "start:debug": "nest start --debug --watch -b swc",
    "build": "nest build -b swc",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src scripts test",
    "format": "biome format --write src scripts test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:foundation": "vitest run test/foundation",
    "test:waitlist": "vitest run test/waitlist",
    "quality": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm prisma validate",
    "inventory:legacy": "tsx scripts/migration/inventory-resolved.mts",
    "inventory:legacy:raw": "tsx scripts/migration/inventory-legacy.mts",
    "legacy:start": "node server.js",
    "legacy:dev": "nodemon server.js",
    "postinstall": "node scripts/fix-aeko-chain.cjs && prisma generate",
    "migrate:deploy": "prisma migrate deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "@adminjs/express": "^6.1.1",
    "@adminjs/prisma": "^5.0.4",
    "@adminjs/sequelize": "^4.1.1",
    "@aeko-chain/sdk": "^0.1.3",
    "@aeko-chain/web3.js": "^0.1.2",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/throttler": "^6.5.0",
    "@noble/ed25519": "^3.1.0",
    "@paystack/paystack-sdk": "^1.0.1",
    "@prisma/client": "^5.10.0",
    "@solana/web3.js": "^1.98.4",
    "@stripe/stripe-js": "^8.4.0",
    "adminjs": "^7.8.15",
    "axios": "^1.8.4",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.2",
    "borsh": "^2.0.0",
    "bs58": "^6.0.0",
    "cloudinary": "^1.41.3",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-formidable": "^1.2.0",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.1",
    "express-validator": "^7.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "flutterwave-node-v3": "^1.1.15",
    "form-data": "^4.0.0",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.18.1",
    "rxjs": "^7.8.2",
    "sequelize": "^6.37.7",
    "sharp": "^0.34.3",
    "sib-api-v3-sdk": "^8.5.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "speakeasy": "^2.0.0",
    "stripe": "^19.3.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "zeptomail": "^7.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.6",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.46",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "nodemon": "^3.0.1",
    "prisma": "^5.10.0",
    "supertest": "^7.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
